# Copy to .env and adjust. Never commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql+psycopg://betaggregator:betaggregator@localhost:5432/betaggregator
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BACKEND_URL=redis://localhost:6379/1
LOG_LEVEL=INFO
# Leave as "threading" for local dev; use "gevent" with the gevent gunicorn worker in production.
SOCKETIO_ASYNC_MODE=threading
